# RoPART local artefacts (regenerable — keep out of git)
# NB: git does not support inline comments in .gitignore — keep them on their own lines.

# run output dirs / checkpoints
out/

# wandb run logs (offline + online cache)
wandb/

# CIFAR-100 download (anchored: ropart/scripts/data/ holds committed figure
# source data and must not be caught by this rule)
/data/

# Python bytecode caches
__pycache__/
*.pyc
